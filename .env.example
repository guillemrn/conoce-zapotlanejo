# Make.com (Integromat) Custom Webhook URL
# Crea un escenario en Make con el módulo "Custom Webhook", copia tu URL y pégala en .env.local
MAKE_WEBHOOK_URL=https://hook.us2.make.com/your-custom-webhook-id-here

# Microsoft Clarity
# Agrega este ID como variable de entorno en Vercel.
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id
